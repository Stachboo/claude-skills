{
  "minEntropy": 3.5,
  "patterns": [
    { "id": "aws-access-key", "rx": "AKIA[0-9A-Z]{16}", "entropy": false },
    { "id": "aws-secret-key", "rx": "(?i)aws.{0,20}['\"][0-9a-zA-Z/+]{40}['\"]", "entropy": true },
    { "id": "github-pat", "rx": "ghp_[0-9A-Za-z]{36}", "entropy": false },
    { "id": "github-fine-grained", "rx": "github_pat_[0-9A-Za-z_]{82}", "entropy": false },
    { "id": "openai-key", "rx": "sk-[A-Za-z0-9]{20,}T3BlbkFJ[A-Za-z0-9]{20,}", "entropy": false },
    { "id": "anthropic-key", "rx": "sk-ant-[A-Za-z0-9-]{20,}", "entropy": false },
    { "id": "google-api-key", "rx": "AIza[0-9A-Za-z_-]{35}", "entropy": false },
    { "id": "slack-token", "rx": "xox[baprs]-[0-9A-Za-z-]{10,}", "entropy": false },
    { "id": "stripe-secret", "rx": "sk_live_[0-9a-zA-Z]{24,}", "entropy": false },
    { "id": "private-key-block", "rx": "-----BEGIN (RSA |EC |OPENSSH |PGP )?PRIVATE KEY-----", "entropy": false },
    { "id": "jwt", "rx": "eyJ[A-Za-z0-9_-]{10,}\\.eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}", "entropy": false },
    { "id": "generic-secret-assign", "rx": "(?i)(secret|token|passwd|password|api[_-]?key)\\s*[:=]\\s*['\"][0-9a-zA-Z/+_\\-]{16,}['\"]", "entropy": true }
  ],
  "allowlistGlobs": ["**/.env.example", "**/*.test.*", "**/tests/**", "**/__mocks__/**", "**/docs/**", "**/*.md"]
}
